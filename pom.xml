<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>


    <groupId>com.smarthostel</groupId>

    <artifactId>HostelManagementSystem</artifactId>

    <!-- SNAPSHOT will deploy to maven-snapshots-1 -->
    <!-- Change to 1.0 for release deployment -->

    <version>0.0.1-SNAPSHOT</version>

    <packaging>war</packaging>


    <name>HostelManagementSystem</name>



    <properties>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.source>17</maven.compiler.source>

        <maven.compiler.target>17</maven.compiler.target>


        <!-- SonarQube Configuration -->

        <sonar.projectKey>HostelManagement</sonar.projectKey>

        <sonar.projectName>HostelManagement</sonar.projectName>


    </properties>




    <!-- Nexus Repository Configuration -->

    <distributionManagement>


        <!-- SNAPSHOT Repository -->

        <snapshotRepository>

            <id>nexus-snapshots</id>

            <name>Nexus Snapshot Repository</name>

            <url>
                http://100.31.42.86:8081/repository/maven-snapshots-1/
            </url>

        </snapshotRepository>



        <!-- RELEASE Repository -->

        <repository>

            <id>nexus-releases</id>

            <name>Nexus Release Repository</name>

            <url>
                http://100.31.42.86:8081/repository/maven-releases/
            </url>

        </repository>


    </distributionManagement>




    <dependencies>


        <!-- JUnit Testing -->

        <dependency>

            <groupId>junit</groupId>

            <artifactId>junit</artifactId>

            <version>3.8.1</version>

            <scope>test</scope>

        </dependency>



        <!-- Servlet API -->

        <dependency>

            <groupId>javax.servlet</groupId>

            <artifactId>javax.servlet-api</artifactId>

            <version>4.0.1</version>

            <scope>provided</scope>

        </dependency>



        <!-- MySQL Connector -->

        <dependency>

            <groupId>com.mysql</groupId>

            <artifactId>mysql-connector-j</artifactId>

            <version>8.0.33</version>

        </dependency>


    </dependencies>




    <build>


        <finalName>HostelManagementSystem</finalName>



        <plugins>



            <!-- Java Compiler -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>

                <artifactId>maven-compiler-plugin</artifactId>

                <version>3.11.0</version>


                <configuration>

                    <source>17</source>

                    <target>17</target>

                </configuration>


            </plugin>




            <!-- WAR Packaging -->

            <plugin>

                <groupId>org.apache.maven.plugins</groupId>

                <artifactId>maven-war-plugin</artifactId>

                <version>3.4.0</version>


            </plugin>




            <!-- SonarQube Scanner -->

            <plugin>

                <groupId>org.sonarsource.scanner.maven</groupId>

                <artifactId>sonar-maven-plugin</artifactId>

                <version>5.2.0.4988</version>


            </plugin>



        </plugins>


    </build>



</project>
